# Copy this file to .env and fill in at least one key. Never commit .env.
# With no keys at all, INKSPARK runs in demo mode with sample lines.

# --- FREE: Groq (main provider for text poems) ---
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- FREE: Google Gemini (used for picture prompts, and as backup) ---
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OPTIONAL, PAID: Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Order to try providers in (first one with a key wins; the rest are backups)
PROVIDERS=groq,gemini,anthropic

PORT=3000

# Per-visitor limits (keep these low so the free daily quota lasts)
RATE_PER_MINUTE=6
RATE_PER_DAY=40

# Simultaneous AI calls across all users, and how many can wait in line
MAX_CONCURRENT=4
MAX_QUEUE=20
